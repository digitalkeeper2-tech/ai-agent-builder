{
  "name": "ai-agent-builder",
  "version": "1.0.0",
  "description": "Build AI agents with custom orders. Every stage as a Model and Module with full interchangeability.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "setup": "node setup.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "clean": "rmdir /s /q dist node_modules",
    "quick-start": "npx ts-node examples/quick-start.ts",
    "self-improve": "npx ts-node examples/self-improvement-example.ts",
    "prebuild": "npm run clean || true"
  },
  "keywords": [
    "ai",
    "agent",
    "builder",
    "llm",
    "plugin-system",
    "modular",
    "extensible"
  ],
  "author": "digitalkeeper2-tech",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  }
}
